# ============================================================
# curator-backend: Environment Configuration
# ============================================================
# Copy this file to .env and fill in values for local development.
# In Docker Compose the environment: block sets every variable. In dev
# the service directory is bind-mounted at /app, so a .env here would
# still fill any variable that block leaves unset; prod has no mount.
#
# Each variable is marked REQUIRED or optional. A missing REQUIRED
# variable stops the application at startup with an error naming it;
# an optional one falls back to the default shown.
# ============================================================

# ----------------------------------------------------------
# Oxigraph triple store
# ----------------------------------------------------------

# Which TripleStore implementation to build. Only "oxigraph" ships today.
# Optional; default: oxigraph.
TRIPLESTORE=oxigraph

# Base URL of the Oxigraph HTTP endpoint (no trailing slash).
# Local dev: http://localhost:7878
# Docker Compose: http://oxigraph:7878  (service name resolves inside Docker)
# REQUIRED.
OXIGRAPH_URL=http://localhost:7878

# Named graph URI where all instance data is written and read.
# Every SPARQL query is scoped to this graph (FROM <uri>).
# Every Turtle load targets this graph (?graph=<uri>).
# Change this per deployment to isolate data sets.
# REQUIRED.
DATA_GRAPH_URI=https://rosfeatr.eu/rdf/graph/

# Read timeout (seconds) for bulk Turtle loads on startup. Oxigraph withholds
# response headers until a document is fully parsed and indexed, so seeding
# large vocab files (e.g. the ~38 MB Glottolog language list) can take over a
# minute. Raise this if you seed very large files. Optional; default: 300.
OXIGRAPH_LOAD_TIMEOUT=300

# ----------------------------------------------------------
# Base IRIs
# ----------------------------------------------------------
# The namespaces this deployment's records and shapes are named under. Both
# backends must get the same two values. Each must end with "/" or "#", since
# IRIs are built by appending a name to it. A fork sets its own here; no code
# changes. Both REQUIRED.
#
# Dereferencing: the reader answers on fixed paths, /rdf/data/{name} and
# /rdf/schema/{name}. An IRI resolves by being visited only when its host
# serves this stack and its path is one of those two, as in the examples below.
# Any other namespace still works for storing and editing data.

# Namespace of every record the curator mints, digital copies included.
# With DATA_BASE_URI=https://rosfeatr.eu/rdf/data/ :
#   a new Place record      -> https://rosfeatr.eu/rdf/data/Place_4f3a9d12
#   its helper nodes        -> https://rosfeatr.eu/rdf/data/Place_4f3a9d12_hasAgentRole_0
#   an uploaded PDF's node  -> https://rosfeatr.eu/rdf/data/File_0123abcd
#   its schema:contentUrl   -> https://rosfeatr.eu/rdf/data/File_0123abcd/content
#   reader page for a record-> GET /rdf/data/Place_4f3a9d12
# The curator frontend gets it from GET /api/v1/dataexplorer/meta/schema and
# makes objects under it clickable record links in the validation panel.
DATA_BASE_URI=https://rosfeatr.eu/rdf/data/

# Namespace of the SHACL shapes in the loaded schema. It must match the schema
# file: it is not used to rename shapes, only to find them.
# With SCHEMA_BASE_URI=https://rosfeatr.eu/rdf/schema/ :
#   a shape in rfdb_schema.ttl   -> https://rosfeatr.eu/rdf/schema/PlaceShape
#   served by the reader at -> GET /rdf/schema/PlaceShape
#   READ_ONLY_SHAPES lists shapes by these IRIs.
SCHEMA_BASE_URI=https://rosfeatr.eu/rdf/schema/

# ----------------------------------------------------------
# Long-text fields
# ----------------------------------------------------------

# JSON array of predicate IRIs whose form fields are multi-line text areas.
# SHACL has no long-text hint, so the field's sh:path decides. Any other text
# field gets a one-line input and saves the same way. Both backends must get
# the same value. Optional; the default is the rfdb schema's set:
#   rdfs:comment, dcterms:description, dcterms:abstract, skos:definition,
#   skos:note, skos:scopeNote, and core:text (title-page transcription).
# Example: a field with sh:path dcterms:description renders as a text area.
# An empty value means no long-text fields.
# LONG_TEXT_PREDICATES=["http://purl.org/dc/terms/description", "http://www.w3.org/2004/02/skos/core#note"]

# ----------------------------------------------------------
# File paths (relative to the curator-backend working directory)
# ----------------------------------------------------------

# Path to the SHACL schema file used by SchemaExtractor and ShaclValidator.
# In Docker the schema/ folder is mounted read-only at /app/schema/.
# REQUIRED.
SCHEMA_PATH=schema/rfdb_schema.ttl

# Path(s) to vocab Turtle files — controlled-vocabulary seed (roles, types, places, etc.).
# Loaded into Oxigraph on every startup when SEED_VOCAB_ON_STARTUP=true.
# A JSON array of paths, even for a single file. REQUIRED.
VOCAB_PATH=["data/rfdb_vocab.ttl", "data/glottolog_language.ttl"]

# Path to the sample-data Turtle file (test/sample fixture data).
# Only loaded when SEED_TEST_DATA_ON_STARTUP=true. REQUIRED even when that is false.
DATA_PATH=data/rfdb_data.ttl

# ----------------------------------------------------------
# Startup seeding
# ----------------------------------------------------------

# Wipe the whole store (every named graph and the default graph) before seeding.
# Irreversible: keep false outside dev/test.
# REQUIRED.
RESET_DATA_ON_STARTUP=false

# Load VOCAB_PATH into Oxigraph at every startup (idempotent).
# Should be true in all environments so relation fields have autocomplete data.
# REQUIRED.
SEED_VOCAB_ON_STARTUP=true

# Load DATA_PATH (sample/test data) at startup.
# Set to true in local dev/test only; keep false in production. REQUIRED.
SEED_TEST_DATA_ON_STARTUP=false

# Set true to disable write/delete endpoints (demo/presentation mode).
# Reads and validation endpoints remain available. Optional; default: false.
READ_ONLY=false

# JSON array of shape URIs whose records are read-only (browse/select only).
# Shapes in this list return readOnly:true from /api/v1/curator/shapes and
# reject POST /api/v1/curator/entities and DELETE /api/v1/curator/entities?id=…
# with HTTP 403.
# Optional; defaults to [] (no shape-level restrictions).
# READ_ONLY_SHAPES=["https://rosfeatr.eu/rdf/schema/LanguageShape"]

# ----------------------------------------------------------
# Object storage (Garage / S3-compatible) — digital-copy uploads
# ----------------------------------------------------------

# All optional. Leave S3_ENDPOINT empty to run without object storage; the
# upload routes then return 503. Defaults: empty endpoint, region garage,
# bucket sources, empty credentials.
S3_ENDPOINT=http://localhost:3900
S3_REGION=garage
S3_BUCKET=sources
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Per-file upload ceiling in megabytes; 0 disables the cap.
# Optional; default: 500.
MAX_UPLOAD_MB=500

# ----------------------------------------------------------
# CORS
# ----------------------------------------------------------

# JSON array of origins allowed to call the API.
# Include the Vite dev server and any preview ports you use locally. REQUIRED.
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000"]

# ----------------------------------------------------------
# Logging
# ----------------------------------------------------------

# Minimum log level: DEBUG | INFO | WARNING | ERROR | CRITICAL
# Optional; default: INFO.
LOG_LEVEL=INFO

# LOG_FILE (path to the JSON-lines log file) is intentionally not exposed
# here: it's pinned to the curator_backend_logs Docker volume mount and isn't meant
# to be overridden in the supported deployments. See docker-compose.yml.
