# ============================================================
# RFDB Data Explorer Backend — Environment Configuration
# ============================================================
# Copy this file to .env and fill in values for local development.
# In Docker Compose the environment: block sets every variable. In dev
# the service directory is bind-mounted at /app, so a .env here would
# still fill any variable that block leaves unset; prod has no mount.
#
# This is the read service. Its settings are exactly
# rfdb_core.config.BaseServiceSettings — the shared base — with no additions.
# Compare curator-backend/.env.example: everything there and not here is a write
# concern (VOCAB_PATH, DATA_PATH, RESET_DATA_ON_STARTUP, SEED_*, READ_ONLY,
# MAX_UPLOAD_MB). Setting any of them here has no effect: extra="ignore" means
# this service does not see them, so a single shared .env across both services
# is safe. READ_ONLY_SHAPES looks like a write concern but is not: it is in the
# shared base and this service reads it to set the readOnly flags in its shape
# catalogue, so it is listed below.
#
# REQUIRED: OXIGRAPH_URL, DATA_GRAPH_URI, DATA_BASE_URI, SCHEMA_BASE_URI,
# SCHEMA_PATH, CORS_ORIGINS. A missing one stops the application at startup
# with an error naming it. Every other variable is optional and falls back to
# the default shown.
# ============================================================

# ----------------------------------------------------------
# Triple store
# ----------------------------------------------------------

# Which TripleStore implementation to build. Only "oxigraph" ships today; the
# seam (rfdb_core.triplestore) exists so a second one is a config change.
# Default: oxigraph.
TRIPLESTORE=oxigraph

# Base URL of the Oxigraph HTTP endpoint (no trailing slash).
# Local dev: http://localhost:7878
# Docker Compose: http://oxigraph:7878  (service name resolves inside Docker)
OXIGRAPH_URL=http://localhost:7878

# Named graph URI that reads are scoped to (FROM <uri>). Must match the graph
# curator-backend writes to, or this service will correctly report an empty store.
DATA_GRAPH_URI=https://rosfeatr.eu/rdf/graph/

# Read timeout (seconds) for bulk Turtle loads. Unused here — this service never
# loads Turtle — but it is part of the shared settings base, so it is listed for
# completeness. Default: 300.
OXIGRAPH_LOAD_TIMEOUT=300

# ----------------------------------------------------------
# Base IRIs
# ----------------------------------------------------------
# The namespaces this deployment's records and shapes are named under. Both
# backends must get the same two values. Each must end with "/" or "#", since
# IRIs are built by appending a name to it. A fork sets its own here; no code
# changes. Both REQUIRED.
#
# Dereferencing: the reader answers on fixed paths, /rdf/data/{name} and
# /rdf/schema/{name}. An IRI resolves by being visited only when its host
# serves this stack and its path is one of those two, as in the examples below.
# Any other namespace still works for storing and editing data.

# Namespace of every record the curator mints, digital copies included.
# With DATA_BASE_URI=https://rosfeatr.eu/rdf/data/ :
#   a new Place record      -> https://rosfeatr.eu/rdf/data/Place_4f3a9d12c07e
#   its helper nodes        -> https://rosfeatr.eu/rdf/data/AgentRole_a3f2b1c9d4e5
#   an uploaded PDF's node  -> https://rosfeatr.eu/rdf/data/File_0123abcd0123
#   its schema:contentUrl   -> https://rosfeatr.eu/rdf/data/File_0123abcd0123/content
#   reader page for a record-> GET /rdf/data/Place_4f3a9d12c07e
# The curator frontend gets it from GET /api/v1/dataexplorer/meta/schema and
# makes objects under it clickable record links in the validation panel.
DATA_BASE_URI=https://rosfeatr.eu/rdf/data/

# Namespace of the SHACL shapes in the loaded schema. It must match the schema
# file: it is not used to rename shapes, only to find them.
# With SCHEMA_BASE_URI=https://rosfeatr.eu/rdf/schema/ :
#   a shape in rfdb_schema.ttl   -> https://rosfeatr.eu/rdf/schema/PlaceShape
#   served by the reader at -> GET /rdf/schema/PlaceShape
#   READ_ONLY_SHAPES lists shapes by these IRIs.
SCHEMA_BASE_URI=https://rosfeatr.eu/rdf/schema/

# ----------------------------------------------------------
# Project
# ----------------------------------------------------------

# Name of the knowledge base this deployment serves, shown to users: the
# reader's HTML page titles ("<record> — RossijskijFeatrDB"), the editor's
# header and tab title, and the API documentation title. Optional; default:
# RossijskijFeatrDB. Give both backends the same value.
# PROJECT_NAME=RossijskijFeatrDB

# ----------------------------------------------------------
# Long-text fields
# ----------------------------------------------------------

# JSON array of predicate IRIs whose form fields are multi-line text areas.
# SHACL has no long-text hint, so the field's sh:path decides. Any other text
# field gets a one-line input and saves the same way. Both backends must get
# the same value. Optional; the default is the rfdb schema's set:
#   rdfs:comment, dcterms:description, dcterms:abstract, skos:definition,
#   skos:note, skos:scopeNote, and core:text (title-page transcription).
# Example: a field with sh:path dcterms:description renders as a text area.
# An empty value means no long-text fields.
# LONG_TEXT_PREDICATES=["http://purl.org/dc/terms/description", "http://www.w3.org/2004/02/skos/core#note"]

# ----------------------------------------------------------
# External identifiers
# ----------------------------------------------------------

# JSON object mapping a predicate IRI to a URL template, for identifiers the
# schema stores as plain text. $1 is replaced by the identifier, and every UI
# shows the value as a link: the form under the input, the graph explorer's
# inspector, the reader's HTML page. Both backends must get the same value.
# Optional; the default is the rfdb schema's two:
#   wdt:P214  (VIAF) -> https://viaf.org/en/viaf/$1
#   wdt:P5504 (RISM) -> https://rism.online/$1
# Example: a record with wdt:P214 "293925180" links to
#   https://viaf.org/en/viaf/293925180
# An empty value means no links. Each template must contain $1.
# EXTERNAL_ID_LINKS={"http://www.wikidata.org/prop/direct/P214": "https://viaf.org/en/viaf/$1"}

# ----------------------------------------------------------
# Record search
# ----------------------------------------------------------

# JSON array of predicate IRIs holding a record's other names. The search behind
# the editor's link fields matches them besides rdfs:label and the IRI, and
# still lists a record under its rdfs:label. Only this service reads it.
# Optional; the default is the rfdb schema's skos:altLabel.
# Example: typing "Petrograd" finds the Place labelled "Sankt-Peterburg".
# An empty value means the label and IRI only.
# SEARCH_LABEL_PREDICATES=["http://www.w3.org/2004/02/skos/core#altLabel"]

# ----------------------------------------------------------
# File paths (relative to the dataexplorer-backend working directory)
# ----------------------------------------------------------

# Path to the SHACL schema file used by SchemaExtractor. Read-only here: the
# schema is the map every read route navigates by (which shapes exist, which
# predicates count as relations), never something this service validates against.
# In Docker the schema/ folder is mounted read-only at /app/schema/.
SCHEMA_PATH=schema/rfdb_schema.ttl

# ----------------------------------------------------------
# Shape policy
# ----------------------------------------------------------

# JSON array of shape URIs whose records are read-only. This service stamps
# readOnly:true on those shapes in its catalogue, which the editor reads, so it
# must equal the curator's value. Default: [].
# READ_ONLY_SHAPES=["https://rosfeatr.eu/rdf/schema/LanguageShape"]

# ----------------------------------------------------------
# CORS
# ----------------------------------------------------------

# JSON array of allowed browser origins. Must NOT contain "*" — the app aborts at
# import time if it does, because the CORS spec forbids a wildcard alongside
# allow_credentials=True and the middleware fails silently rather than loudly.
#
# Both frontends read from this service, so both dev origins belong here:
# :5173 = curator-frontend; graphexplorer-frontend is published on host port 80 (http's
# default port, so its browser Origin omits the port entirely).
CORS_ORIGINS=["http://localhost:5173", "http://localhost"]

# ----------------------------------------------------------
# Object storage (Garage / S3-compatible) — digital-copy downloads
# ----------------------------------------------------------

# Leave S3_ENDPOINT empty to run without object storage:
# GET /api/v1/dataexplorer/meta/files then reports {"configured": false} with
# zeroed stats instead of erroring, and the panel still renders. Downloads will
# 503.
S3_ENDPOINT=http://localhost:3900
S3_REGION=garage
S3_BUCKET=sources
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ----------------------------------------------------------
# Logging
# ----------------------------------------------------------

# Structured JSON-lines log file. In Docker this is pinned to the
# dataexplorer_backend_logs volume mounted at /app/logs.
LOG_FILE=logs/app.jsonl
LOG_LEVEL=INFO

# Keep crash/restart history, but truncate once when a fresh container starts.
TRUNCATE_LOG_ON_STARTUP=false
TRUNCATE_LOG_ON_FRESH_CONTAINER_START=true
