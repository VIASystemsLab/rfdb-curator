    dcterms:language <http://glottolog.org/resource/languoid/id/ital1282> ;
    core:text """LA / FORZA / DELL'AMORE, / E / DELL'ODIO / DRAMA / Da rappresentarsi del Regio Ducal / Teatro di Milano / SOTTO IL REALE PATROCINIO / DELLA / SACRA REALA MAESTA' / DI / CARLO EMANUELE / Rè di Sardegna, di Cipro, / di Gierusalemme, e / Duca &c. &c. &c. / Nel Carnovale dell'anno 1734. / IN MILANO, MDCCXXXIV / Nella R.D.C., Per Giuseppe Richino Malatesta / Stampatore Regio Camerale. / Con licenza de' Superiori."""@it ;
