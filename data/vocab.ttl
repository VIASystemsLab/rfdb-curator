@prefix core: <https://w3id.org/polifonia/ontology/core/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rfdb: <https://rosfeatr.eu/rdf/data/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

# Canonical controlled vocabulary for the editor seed stage.
# NOTE: data/examples/data.ttl is test-only fixture data and must not be treated as canonical seed.

rfdb:DocumentTypeScheme a skos:ConceptScheme ;
  rdfs:label "RFDB Document Types"@en ;
  skos:altLabel "Tipi di documento RFDB"@it .

rfdb:RoleTypeScheme a skos:ConceptScheme ;
  rdfs:label "RFDB Role Types"@en ;
  skos:altLabel "Tipi di ruolo RFDB"@it .

# --- Core Type vocabulary ---
rfdb:Libretto a core:Type, skos:Concept ;
  rdfs:label "Libretto"@en ;
  skos:altLabel "Libretto"@it ;
  skos:inScheme rfdb:DocumentTypeScheme .

rfdb:LibrettoStampa a core:Type, skos:Concept ;
  rdfs:label "Libretto a stampa"@it ;
  skos:altLabel "Printed libretto"@en ;
  skos:inScheme rfdb:DocumentTypeScheme ;
  skos:broader rfdb:Libretto .

rfdb:LibrettoManoscritto a core:Type, skos:Concept ;
  rdfs:label "Libretto manoscritto"@it ;
  skos:altLabel "Manuscript libretto"@en ;
  skos:inScheme rfdb:DocumentTypeScheme ;
  skos:broader rfdb:Libretto .

# --- Role type vocabulary ---
rfdb:Compositore a core:Role, skos:Concept ;
  rdfs:label "Compositore"@it ;
  skos:altLabel "Composer"@en ;
  skos:inScheme rfdb:RoleTypeScheme .

rfdb:Librettista a core:Role, skos:Concept ;
  rdfs:label "Librettista"@it ;
  skos:altLabel "Librettist"@en ;
  skos:inScheme rfdb:RoleTypeScheme .

rfdb:Traduttore a core:Role, skos:Concept ;
  rdfs:label "Traduttore"@it ;
  skos:altLabel "Translator"@en ;
  skos:inScheme rfdb:RoleTypeScheme .
