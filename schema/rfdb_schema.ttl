@prefix cidoc:   <http://www.cidoc-crm.org/cidoc-crm/> .
@prefix core:    <https://w3id.org/polifonia/ontology/core/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf:    <http://xmlns.com/foaf/0.1/> .
@prefix glottolog: <http://glottolog.org/resource/languoid/id/> .
@prefix lrmoo:   <http://iflastandards.info/ns/lrm/lrmoo/> .
@prefix mm:      <https://w3id.org/polifonia/ontology/music-meta/> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix prism:   <http://prismstandard.org/namespaces/basic/2.0/> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rfdb:    <https://rosfeatr.eu/rdf/data/> .
@prefix rfdbs:   <https://rosfeatr.eu/rdf/schema/> .
@prefix schema:  <http://schema.org/> .
@prefix sh:      <http://www.w3.org/ns/shacl#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix source:  <https://w3id.org/polifonia/ontology/source/> .
@prefix wdt:     <http://www.wikidata.org/prop/direct/> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .

# Namespaces used by the integrated external vocabularies, beyond the ones
# above. The shapes do not use them; they are declared so the prefix map
# covers the integrated data too.
# Polifonia Core, Music Meta and Source; Glottolog:
@prefix dc:      <http://purl.org/dc/elements/1.1/> .
# Polifonia Music Meta and Source:
@prefix cc:      <http://creativecommons.org/ns#> .
@prefix vann:    <http://purl.org/vocab/vann/> .
# Glottolog:
@prefix bibo:    <http://purl.org/ontology/bibo/> .
@prefix dctype:  <http://purl.org/dc/dcmitype/> .
@prefix frbr:    <http://purl.org/vocab/frbr/core#> .
@prefix geo:     <http://www.w3.org/2003/01/geo/wgs84_pos#> .
@prefix gold:    <http://purl.org/linguistics/gold/> .
@prefix isbd:    <http://iflastandards.info/ns/isbd/elements/> .
@prefix lexvo:   <http://lexvo.org/ontology#> .
@prefix vcard:   <http://www.w3.org/2001/vcard-rdf/3.0#> .
@prefix void:    <http://rdfs.org/ns/void#> .

# Namespaces used by the data files under data/, beyond the ones above. The
# shapes do not use them; they are declared so the prefix map covers the
# repository's data too.
# data/examples/data.ttl:
@prefix wd:      <http://www.wikidata.org/entity/> .

# The schema's own release and prefix map, kept as data so they survive
# parsing. Every @prefix above has a matching sh:declare below, and
# owl:versionInfo matches the vX.Y.Z tag of the release.
rfdbs:
  a owl:Ontology ;
  owl:versionInfo "2.2.2" ;
  sh:declare
    [ sh:prefix "cidoc" ; sh:namespace "http://www.cidoc-crm.org/cidoc-crm/"^^xsd:anyURI ] ,
    [ sh:prefix "core" ; sh:namespace "https://w3id.org/polifonia/ontology/core/"^^xsd:anyURI ] ,
    [ sh:prefix "dcterms" ; sh:namespace "http://purl.org/dc/terms/"^^xsd:anyURI ] ,
    [ sh:prefix "foaf" ; sh:namespace "http://xmlns.com/foaf/0.1/"^^xsd:anyURI ] ,
    [ sh:prefix "glottolog" ; sh:namespace "http://glottolog.org/resource/languoid/id/"^^xsd:anyURI ] ,
    [ sh:prefix "lrmoo" ; sh:namespace "http://iflastandards.info/ns/lrm/lrmoo/"^^xsd:anyURI ] ,
    [ sh:prefix "mm" ; sh:namespace "https://w3id.org/polifonia/ontology/music-meta/"^^xsd:anyURI ] ,
    [ sh:prefix "owl" ; sh:namespace "http://www.w3.org/2002/07/owl#"^^xsd:anyURI ] ,
    [ sh:prefix "prism" ; sh:namespace "http://prismstandard.org/namespaces/basic/2.0/"^^xsd:anyURI ] ,
    [ sh:prefix "rdf" ; sh:namespace "http://www.w3.org/1999/02/22-rdf-syntax-ns#"^^xsd:anyURI ] ,
    [ sh:prefix "rdfs" ; sh:namespace "http://www.w3.org/2000/01/rdf-schema#"^^xsd:anyURI ] ,
    [ sh:prefix "rfdb" ; sh:namespace "https://rosfeatr.eu/rdf/data/"^^xsd:anyURI ] ,
    [ sh:prefix "rfdbs" ; sh:namespace "https://rosfeatr.eu/rdf/schema/"^^xsd:anyURI ] ,
    [ sh:prefix "schema" ; sh:namespace "http://schema.org/"^^xsd:anyURI ] ,
    [ sh:prefix "sh" ; sh:namespace "http://www.w3.org/ns/shacl#"^^xsd:anyURI ] ,
    [ sh:prefix "skos" ; sh:namespace "http://www.w3.org/2004/02/skos/core#"^^xsd:anyURI ] ,
    [ sh:prefix "source" ; sh:namespace "https://w3id.org/polifonia/ontology/source/"^^xsd:anyURI ] ,
    [ sh:prefix "wdt" ; sh:namespace "http://www.wikidata.org/prop/direct/"^^xsd:anyURI ] ,
    [ sh:prefix "xsd" ; sh:namespace "http://www.w3.org/2001/XMLSchema#"^^xsd:anyURI ] ,
    # External vocabularies: Polifonia Core, Music Meta and Source; Glottolog.
    [ sh:prefix "dc" ; sh:namespace "http://purl.org/dc/elements/1.1/"^^xsd:anyURI ] ,
    # External vocabularies: Polifonia Music Meta and Source.
    [ sh:prefix "cc" ; sh:namespace "http://creativecommons.org/ns#"^^xsd:anyURI ] ,
    [ sh:prefix "vann" ; sh:namespace "http://purl.org/vocab/vann/"^^xsd:anyURI ] ,
    # External vocabularies: Glottolog.
    [ sh:prefix "bibo" ; sh:namespace "http://purl.org/ontology/bibo/"^^xsd:anyURI ] ,
    [ sh:prefix "dctype" ; sh:namespace "http://purl.org/dc/dcmitype/"^^xsd:anyURI ] ,
    [ sh:prefix "frbr" ; sh:namespace "http://purl.org/vocab/frbr/core#"^^xsd:anyURI ] ,
    [ sh:prefix "geo" ; sh:namespace "http://www.w3.org/2003/01/geo/wgs84_pos#"^^xsd:anyURI ] ,
    [ sh:prefix "gold" ; sh:namespace "http://purl.org/linguistics/gold/"^^xsd:anyURI ] ,
    [ sh:prefix "isbd" ; sh:namespace "http://iflastandards.info/ns/isbd/elements/"^^xsd:anyURI ] ,
    [ sh:prefix "lexvo" ; sh:namespace "http://lexvo.org/ontology#"^^xsd:anyURI ] ,
    [ sh:prefix "vcard" ; sh:namespace "http://www.w3.org/2001/vcard-rdf/3.0#"^^xsd:anyURI ] ,
    [ sh:prefix "void" ; sh:namespace "http://rdfs.org/ns/void#"^^xsd:anyURI ] ,
    # Data files: data/examples/data.ttl.
    [ sh:prefix "wd" ; sh:namespace "http://www.wikidata.org/entity/"^^xsd:anyURI ] .

# ================================
# Shape for Place
# ================================
rfdbs:PlaceShape
  a sh:NodeShape ;
  sh:targetClass core:Place ;
  rdfs:label "Place"@en, "Luogo"@it ;
  sh:description "A geographic location or place, which may be associated with various resources such as publication locations or organization locations."@en ;
  sh:property [
    sh:path rdfs:label ;
    sh:name "Name"@en, "Nome"@it ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:or (
      [ sh:datatype rdf:langString ]
      [ sh:datatype xsd:string ]
    ) ;
    sh:description "A place must have exactly one label" ;
  ] ;
  sh:property [
    sh:path skos:altLabel ;
    sh:name "Alternative names"@en, "Nomi alternativi"@it ;
    sh:datatype rdf:langString ;
    sh:description "Alternate names for the place (e.g., translations, historical names)" ;
  ] ;
  sh:property [
    sh:path owl:sameAs ;
    sh:name "External identifiers"@en, "Identificativi esterni"@it ;
    sh:minCount 0 ;
    sh:nodeKind sh:IRI ;
    sh:description "External identifier for the place (use to link to Wikidata)" ;
  ] .

# ================================
# Shape for Subject
# ================================
rfdbs:SubjectShape
  a sh:NodeShape ;
  sh:targetClass cidoc:E89_Propositional_Object ;
  rdfs:label "Subject"@en, "Soggetto"@it ;
  sh:description "A subject, theme, concept, or topic that can be associated with musical works or other resources. Subjects include stories, plots, characters, and narrative elements."@en ;
  sh:property [
    sh:path rdfs:label ;
    sh:name "Name"@en, "Nome"@it ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:or (
      [ sh:datatype rdf:langString ]
      [ sh:datatype xsd:string ]
    ) ;
    sh:description "A subject must have exactly one label" ;
  ] ;
  sh:property [
    sh:path skos:altLabel ;
    sh:name "Alternative names"@en, "Nomi alternativi"@it ;
    sh:datatype rdf:langString ;
    sh:description "Alternate names for the subject" ;
  ] .

# ================================
# Shape for Type (Document/Source Type)
# ================================
rfdbs:SourceTypeShape
  a sh:NodeShape ;
  sh:targetClass core:Type ;
  rdfs:label "Source Type"@en, "Tipo di fonte"@it ;
  sh:description "A categorization of source documents, such as 'Libretto a stampa' (printed libretto) or 'Score' (musical score)."@en ;
  sh:property [
    sh:path rdfs:label ;
    sh:name "Name"@en, "Nome"@it ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:or (
      [ sh:datatype rdf:langString ]
      [ sh:datatype xsd:string ]
    ) ;
    sh:description "A type must have exactly one canonical label" ;
  ] ;
  sh:property [
    sh:path skos:altLabel ;
    sh:name "Alternative names"@en, "Nomi alternativi"@it ;
    sh:datatype rdf:langString ;
    sh:description "Alternate names for the type" ;
  ] ;
  sh:property [
    sh:path rdfs:comment ;
    sh:name "Description"@en, "Descrizione"@it ;
    sh:maxCount 1 ;
    sh:datatype xsd:string ;
    sh:description "Optional description of the type" ;
  ] .

# ================================
# Shape for Musical Work (Opera/Composition)
# ================================
rfdbs:MusicalWorkShape
  a sh:NodeShape ;
  sh:targetClass mm:MusicEntity ;
  sh:class lrmoo:F1_Work ;
  rdfs:label "Musical Work"@en, "Opera musicale"@it ;
  sh:description "A musical work such as an opera or composition. A work is the intellectual creation itself, distinct from its various expressions and manifestations."@en ;
  sh:property [
    sh:path rdfs:label ;
    sh:name "Title"@en, "Titolo"@it ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:or (
      [ sh:datatype rdf:langString ]
      [ sh:datatype xsd:string ]
    ) ;
    sh:description "A musical work must have exactly one label" ;
  ] ;
  sh:property [
    sh:path skos:altLabel ;
    sh:name "Alternative titles"@en, "Titoli alternativi"@it ;
    sh:datatype rdf:langString ;
    sh:description "Alternate names for the work (e.g., translations, alternate titles)" ;
  ] ;
  sh:property [
    sh:path dcterms:date ;
    sh:name "Date"@en, "Data"@it ;
    sh:maxCount 1 ;
    sh:or (
      [ sh:datatype xsd:date ]
      [ sh:datatype xsd:gYear ]
      [ sh:datatype xsd:gYearMonth ]
    ) ;
    sh:description "Year or date associated with the work, e.g., '1736'^^xsd:gYear" ;
  ] ;
  sh:property [
    sh:path owl:sameAs ;
    sh:name "External identifiers"@en, "Identificativi esterni"@it ;
    sh:nodeKind sh:IRI ;
    sh:description "External identifiers (e.g., Wikidata, Corago ID). A VIAF ID goes in wdt:P214, not here." ;
  ] ;
  sh:property [
    sh:path wdt:P214 ;
    sh:name "VIAF ID"@en, "Identificativo VIAF"@it ;
    sh:minCount 0 ;
    sh:maxCount 1 ;
    sh:datatype xsd:string ;
    sh:pattern "^[1-9]([0-9]{1,8}|[0-9]{18,21})$" ;
    sh:description "VIAF cluster ID (Wikidata P214) of the work, stored as Wikidata stores it: the bare ID text, e.g. \"293925180\". The VIAF IRI is http://viaf.org/viaf/ followed by the ID, the formatter URI for RDF resource (P1921) Wikidata declares for P214." ;
  ] ;
  sh:property [
    sh:path cidoc:P129_is_about ;
    sh:name "Subjects"@en, "Soggetti"@it ;
    sh:nodeKind sh:IRI ;
    sh:class cidoc:E89_Propositional_Object ;
    sh:node rfdbs:SubjectShape ;
    sh:description "Subject(s) of the work (themes, concepts, events, stories, characters, etc.)" ;
  ] ;
  sh:property [
    sh:path core:hasAgentRole ;
    sh:name "Persons and roles"@en, "Persone e ruoli"@it ;
    sh:nodeKind sh:IRI ;
    sh:class core:AgentRole ;
    sh:node rfdbs:AgentRoleShape ;
    sh:description "Agent roles for the work: composer, etc." ;
  ] .

# ================================
# Shape for Expression (LRMoo F2)
# ================================
rfdbs:ExpressionShape
  a sh:NodeShape ;
  sh:targetClass lrmoo:F2_Expression ;
  rdfs:label "Expression"@en, "Espressione"@it ;
  sh:description "An Expression is a specific intellectual realization of a MusicalWork. For example, a Libretto is an Expression of an Opera (MusicalWork)."@en ;
  sh:property [
    sh:path rdfs:label ;
    sh:name "Title"@en, "Titolo"@it ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:or (
      [ sh:datatype rdf:langString ]
      [ sh:datatype xsd:string ]
    ) ;
    sh:description "An expression must have exactly one label" ;
  ] ;
  sh:property [
    sh:path cidoc:P148i_is_component_of ;
    sh:name "Musical work"@en, "Opera musicale"@it ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:class lrmoo:F1_Work ;
    sh:node rfdbs:MusicalWorkShape ;
    sh:description "The Musical Work this expression is a component of (e.g. the opera a libretto belongs to). Inverse of cidoc:P148_has_component; gives a single child→parent link direction across the WEMI chain." ;
  ] ;
  sh:property [
    sh:path lrmoo:R76_is_derivative_of ;
    sh:name "Derived from"@en, "Derivata da"@it ;
    sh:minCount 0 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:class lrmoo:F2_Expression ;
    sh:node rfdbs:ExpressionShape ;
    sh:description "Source expression this one derives from, e.g. a translated libretto's R76 is derivative of the original-language libretto (LRMoo R76 is derivative of / has derivative)." ;
  ] ;
  sh:property [
    sh:path skos:altLabel ;
    sh:name "Alternative titles"@en, "Titoli alternativi"@it ;
    sh:datatype rdf:langString ;
    sh:description "Alternate names for the expression" ;
  ] ;
  sh:property [
    sh:path core:hasAgentRole ;
    sh:name "Persons and roles"@en, "Persone e ruoli"@it ;
    sh:nodeKind sh:IRI ;
    sh:class core:AgentRole ;
    sh:node rfdbs:AgentRoleShape ;
    sh:description "Agent roles for the expression: librettist (original/translator), arranger, etc." ;
  ] ;
  sh:property [
    sh:path wdt:P214 ;
    sh:name "VIAF ID"@en, "Identificativo VIAF"@it ;
    sh:minCount 0 ;
    sh:maxCount 1 ;
    sh:datatype xsd:string ;
    sh:pattern "^[1-9]([0-9]{1,8}|[0-9]{18,21})$" ;
    sh:description "VIAF cluster ID (Wikidata P214) of the expression, e.g. a translation, stored as Wikidata stores it: the bare ID text, e.g. \"308534901\". The VIAF IRI is http://viaf.org/viaf/ followed by the ID, the formatter URI for RDF resource (P1921) Wikidata declares for P214." ;
  ] ;
  sh:property [
    sh:path rdfs:comment ;
    sh:name "Note"@en, "Nota"@it ;
    sh:maxCount 1 ;
    sh:datatype xsd:string ;
    sh:description "Optional free-text note for the expression" ;
  ] .

# ================================
# Shape for Manifestation (LRMoo F3)
# ================================
rfdbs:ManifestationShape
  a sh:NodeShape ;
  sh:targetClass lrmoo:F3_Manifestation ;
  rdfs:label "Manifestation"@en, "Manifestazione"@it ;
  sh:description "A Manifestation is the product type that embodies an Expression, this accomunates all phisical copies that are distinct Items."@en ;
  sh:property [
    sh:path rdfs:label ;
    sh:name "Title"@en, "Titolo"@it ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:or (
      [ sh:datatype rdf:langString ]
      [ sh:datatype xsd:string ]
    ) ;
    sh:description "A manifestation must have exactly one label" ;
  ] ;

  sh:property [
    sh:path lrmoo:R4_embodies ;
    sh:name "Expression"@en, "Espressione"@it ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:class lrmoo:F2_Expression ;
    sh:node rfdbs:ExpressionShape ;
    sh:description "A manifestation must embody exactly one expression" ;
  ] ;

  sh:property [
    sh:path prism:publicationDate ;
    sh:name "Publication date"@en, "Data di pubblicazione"@it ;
    sh:maxCount 1 ;
    sh:or (
      [ sh:datatype xsd:date ]
      [ sh:datatype xsd:gYear ]
      [ sh:datatype xsd:gYearMonth ]
    ) ;
    sh:description "Publication year or date of the manifestation, e.g., '1736'^^xsd:gYear" ;
  ] ;

  sh:property [
    sh:path rdfs:comment ;
    sh:name "Description"@en, "Descrizione"@it ;
    sh:maxCount 1 ;
    sh:datatype xsd:string ;
    sh:description "Optional description of the manifestation" ;
  ] ;

  sh:property [
    sh:path wdt:P5504 ;
    sh:name "RISM ID"@en, "Identificativo RISM"@it ;
    sh:minCount 0 ;
    sh:maxCount 1 ;
    sh:datatype xsd:string ;
    sh:pattern "^sources/[0-9]+$" ;
    sh:description "RISM ID (Wikidata P5504) of the RISM source record describing this manifestation, print or manuscript, stored as Wikidata stores it: the record type and number, e.g. \"sources/990052516\". A RISM source record lists its exemplars beneath it; those correspond to Sources and go in the Source's rdfs:seeAlso. The RISM page is https://rism.online/ followed by the ID, the formatter URL (P1630) Wikidata declares for P5504." ;
  ] .


# ================================
# Shape for Source/Item (LRMoo F5)
# ================================
rfdbs:SourceShape
  a sh:NodeShape ;
  sh:targetClass source:Source;
  sh:class lrmoo:F5_Item ;
  rdfs:label "Source"@en, "Fonte"@it ;
  sh:description "A particular physical copy of a document, such as a specific printed edition of a libretto, held by a library or archive. Items exemplify Manifestations."@en ;
  sh:property [
    sh:path rdfs:label ;
    sh:name "Title"@en, "Titolo"@it ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:or (
      [ sh:datatype rdf:langString ]
      [ sh:datatype xsd:string ]
    ) ;
    sh:uniqueLang true ;
    sh:description "An item must have exactly one label (Titolo)" ;
  ] ;
  sh:property [
    sh:path skos:altLabel ;
    sh:name "Alternative titles"@en, "Titoli alternativi"@it ;
    sh:datatype rdf:langString ;
    sh:description "Alternate names for the item" ;
  ] ;

  sh:property [
    sh:path prism:publicationDate ;
    sh:name "Publication date"@en, "Data di pubblicazione"@it ;
    sh:maxCount 1 ;
    sh:or (
      [ sh:datatype xsd:date ]
      [ sh:datatype xsd:gYear ]
      [ sh:datatype xsd:gYearMonth ]
    ) ;
    sh:description "Publication year or date (Anno), e.g., '1736'^^xsd:gYear" ;
  ] ;

  sh:property [
    sh:path dcterms:language ;
    sh:name "Language"@en, "Lingua"@it ;
    sh:nodeKind sh:IRI ;
    sh:class dcterms:LinguisticSystem ;
    sh:node rfdbs:LanguageShape ;
    sh:description "Language(s) of the item (Lingua), e.g., from glottolog.org as 'http://glottolog.org/resource/languoid/id/russ1263" ;
  ] ;

  sh:property [
    sh:path core:hasPlace ;
    sh:name "Place of publication"@en, "Luogo di pubblicazione"@it ;
    sh:minCount 0 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:class core:Place ;
    sh:node rfdbs:PlaceShape ;
    sh:description "Place of publication (Luogo), e.g., rfdb:SanPietroburgo" ;
  ] ;

  sh:property [
    sh:path core:hasType ;
    sh:name "Document type"@en, "Tipo documento"@it ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:class core:Type ;
    sh:node rfdbs:SourceTypeShape ;
    sh:description "Document type (Tipo documento), e.g., rfdb:PrintedLibretto for 'Libretto a stampa'" ;
  ] ;

  sh:property [
    sh:path cidoc:P51_has_former_or_current_owner ;
    sh:name "Holding institution"@en, "Ente conservatore"@it ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:class core:Organization ;
    sh:node rfdbs:HoldingOrganizationShape ;
    sh:description "Owning institution (library/archive) for this copy" ;
  ] ;

  sh:property [
    sh:path dcterms:identifier ;
    sh:name "Shelfmark"@en, "Collocazione"@it ;
    sh:minCount 0 ;
    sh:maxCount 1 ;
    sh:datatype xsd:string ;
    sh:description "Shelfmark / call number for this copy" ;
  ] ;

  sh:property [
    sh:path core:text ;
    sh:name "Title-page transcription"@en, "Trascrizione del frontespizio"@it ;
    sh:minCount 0 ;
    sh:or (
      [ sh:datatype rdf:langString ]
      [ sh:datatype xsd:string ]
    ) ;
    sh:description "Fontespizio transcription (title-page text). May be repeated, e.g. one per title page; the language tag is optional." ;
  ] ;

  sh:property [
    sh:path rdfs:seeAlso ;
    sh:name "External links"@en, "Link esterni"@it ;
    sh:nodeKind sh:IRI ;
    # Any rism.online link here must be an exemplar (holding) in RISM's own
    # form; other RISM records describe a different level.
    sh:or (
      [ sh:not [ sh:pattern "^https?://(www\\.)?rism\\.online/" ] ]
      [ sh:pattern "^https://rism\\.online/sources/[0-9]+/holdings/[0-9]+$" ]
    ) ;
    sh:message "A RISM link on a Source must be the IRI of a RISM exemplar (holding), exactly https://rism.online/sources/<number>/holdings/<number>, e.g. https://rism.online/sources/990052516/holdings/204680 (https, no trailing slash). A RISM source ID belongs on the Manifestation as wdt:P5504 \"sources/<number>\"; a RISM person or institution belongs on that Person or Holding Organization record." ;
    sh:description "External references (Link): catalog links, etc. A RISM exemplar of this copy goes here as its holding IRI, exactly https://rism.online/sources/<number>/holdings/<number>; any other rism.online link is rejected. The RISM source ID itself belongs on the Manifestation (wdt:P5504)." ;
  ] ;

  sh:property [
    sh:path rdfs:comment ;
    sh:name "Notes"@en, "Note"@it ;
    sh:maxCount 1 ;
    sh:datatype xsd:string ;
    sh:description "Additional free-text notes" ;
  ] ;

  sh:property [
    sh:path lrmoo:R7_exemplifies ;
    sh:name "Manifestation"@en, "Manifestazione"@it ;
      sh:minCount 0 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:class lrmoo:F3_Manifestation ;
    sh:node rfdbs:ManifestationShape ;
    sh:description "A source (item) may exemplify a Manifestation (which embodies an Expression)" ;
  ] ;
  sh:property [
    sh:path dcterms:contributor ;
    sh:name "Digital copy donor"@en, "Donatore della copia digitale"@it ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:node rfdbs:ContributorShape ;
    sh:description "Donor/provider of the digital copy of this source, when distinct from its physical owner (P51_has_former_or_current_owner)." ;
  ] ;

  sh:property [
    sh:path cidoc:P138i_has_representation ;
    sh:name "Digital copies"@en, "Copie digitali"@it ;
    sh:minCount 0 ;
    sh:nodeKind sh:IRI ;
    sh:class schema:DigitalDocument ;
    sh:node rfdbs:DigitalCopyShape ;
    sh:description "Digitised copies (PDF scans) of this source (Copie digitali). Managed via the file-upload panel, not the generic form." ;
  ] .


# ================================
# Shape for Digital Copy (source PDF scan)
# ================================
# Written by the file-upload endpoint (api/files.py), NOT the generic form:
# the PDF bytes are out-of-band.  The shape exists so the resulting triples
# validate under the same pySHACL pipeline and render in list/context views.
rfdbs:DigitalCopyShape
  a sh:NodeShape ;
  sh:targetClass schema:DigitalDocument ;
  rdfs:label "Digital copy"@en, "Copia digitale"@it ;
  sh:description "A digitised copy (PDF scan) of a source, with integrity and provenance metadata."@en ;
  sh:property [
    sh:path schema:name ;
    sh:name "File name"@en, "Nome del file"@it ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:datatype xsd:string ;
    sh:description "Original filename of the uploaded PDF" ;
  ] ;
  sh:property [
    sh:path schema:encodingFormat ;
    sh:name "Format"@en, "Formato"@it ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:hasValue "application/pdf" ;
    sh:description "MIME type; always application/pdf" ;
  ] ;
  sh:property [
    sh:path schema:contentUrl ;
    sh:name "Download URL"@en, "URL di download"@it ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:datatype xsd:anyURI ;
    sh:description "Stable backend-relative download path (/api/sources/{id}/files/{fileId})" ;
  ] ;
  sh:property [
    sh:path schema:contentSize ;
    sh:name "File size (bytes)"@en, "Dimensione del file (byte)"@it ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:datatype xsd:integer ;
    sh:description "File size in bytes" ;
  ] ;
  sh:property [
    sh:path schema:sha256 ;
    sh:name "SHA-256 checksum"@en, "Checksum SHA-256"@it ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:datatype xsd:string ;
    sh:description "SHA-256 checksum of the file content (integrity / dedup)" ;
  ] ;
  sh:property [
    sh:path schema:numberOfPages ;
    sh:name "Number of pages"@en, "Numero di pagine"@it ;
    sh:minCount 0 ;
    sh:maxCount 1 ;
    sh:datatype xsd:integer ;
    sh:description "Page count (from pypdf); absent if the PDF could not be parsed" ;
  ] .


# ================================
# Shape for Person
# ================================
rfdbs:PersonShape
  a sh:NodeShape ;
  sh:targetClass core:Person ;
  rdfs:label "Person"@en, "Persona"@it ;
  sh:description "A person who may have various roles in cultural works, such as composer, librettist, arranger, or translator."@en ;
  sh:property [
    sh:path rdfs:label ;
    sh:name "Name"@en, "Nome"@it ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:or (
      [ sh:datatype rdf:langString ]
      [ sh:datatype xsd:string ]
    ) ;
    sh:description "A person must have exactly one label" ;
  ] ;
  sh:property [
    sh:path skos:altLabel ;
    sh:name "Alternative names"@en, "Nomi alternativi"@it ;
    sh:datatype rdf:langString ;
    sh:description "Alternate names for the person (e.g., pseudonyms, translated names)" ;
  ] ;
  sh:property [
    sh:path owl:sameAs ;
    sh:name "External identifiers"@en, "Identificativi esterni"@it ;
    sh:nodeKind sh:IRI ;
    sh:description "External identifier for the person (use to link to Wikidata)" ;
  ] ;
  sh:property [
    sh:path wdt:P214 ;
    sh:name "VIAF ID"@en, "Identificativo VIAF"@it ;
    sh:minCount 0 ;
    sh:maxCount 1 ;
    sh:datatype xsd:string ;
    sh:pattern "^[1-9]([0-9]{1,8}|[0-9]{18,21})$" ;
    sh:description "VIAF cluster ID (Wikidata P214), stored as Wikidata stores it: the bare ID text, e.g. \"100995617\". The VIAF IRI is http://viaf.org/viaf/ followed by the ID, the formatter URI for RDF resource (P1921) Wikidata declares for P214." ;
  ] ;
  sh:property [
    sh:path wdt:P5504 ;
    sh:name "RISM ID"@en, "Identificativo RISM"@it ;
    sh:minCount 0 ;
    sh:maxCount 1 ;
    sh:datatype xsd:string ;
    sh:pattern "^people/[0-9]+$" ;
    sh:description "RISM ID (Wikidata P5504), stored as Wikidata stores it: the record type and number, e.g. \"people/1874\". The RISM page is https://rism.online/ followed by the ID, the formatter URL (P1630) Wikidata declares for P5504." ;
  ] .

# ================================
# Shape for Role
# ================================
rfdbs:RoleShape
  a sh:NodeShape ;
  sh:targetClass core:Role ;
  rdfs:label "Role"@en, "Ruolo"@it ;
  sh:description "A role or function that a person may play in relation to a work, such as composer, librettist, translator, arranger, etc."@en ;
  sh:property [
    sh:path rdfs:label ;
    sh:name "Name"@en, "Nome"@it ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:or (
      [ sh:datatype rdf:langString ]
      [ sh:datatype xsd:string ]
    ) ;
    sh:description "A role must have exactly one label" ;
  ] ;
  sh:property [
    sh:path skos:altLabel ;
    sh:name "Alternative names"@en, "Nomi alternativi"@it ;
    sh:datatype rdf:langString ;
    sh:description "Alternate names for the role (e.g., translations)" ;
  ] .

# ================================
# Shape for AgentRole
# ================================
rfdbs:AgentRoleShape
  a sh:NodeShape ;
  sh:targetClass core:AgentRole ;
  sh:closed true ;
  rdfs:label "Agent Role"@en, "Ruolo agente"@it ;
  sh:description "A specific assignment of a role to a person, representing the participation of an agent in a creative or related activity."@en ;
  sh:property [
    sh:path rdf:type ;
    sh:name "Type"@en, "Tipo"@it ;
    sh:minCount 1 ;
    sh:hasValue core:AgentRole ;
    sh:description "An agent role must have at least one rdf:type and core:AgentRole must be among them" ;
  ] ;
  sh:property [
    sh:path core:hasAgent ;
    sh:name "Person"@en, "Persona"@it ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:class core:Person ;
    sh:node rfdbs:PersonShape ;
    sh:description "An agent role must reference exactly one person" ;
  ] ;
  sh:property [
    sh:path core:hasRole ;
    sh:name "Role"@en, "Ruolo"@it ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:class core:Role ;
    sh:node rfdbs:RoleShape ;
    sh:description "An agent role must reference exactly one role" ;
  ] .


# ================================
# Shape for Holding Organization
# ================================
rfdbs:HoldingOrganizationShape
  a sh:NodeShape ;
  sh:targetClass core:Organization ;
  rdfs:label "Holding Organization"@en, "Ente conservatore"@it ;
  sh:description "An institution such as a library, archive, or museum that holds and preserves source documents and other materials."@en ;
  sh:property [
    sh:path rdfs:label ;
    sh:name "Name"@en, "Nome"@it ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:or (
      [ sh:datatype rdf:langString ]
      [ sh:datatype xsd:string ]
    ) ;
    sh:description "Organization name" ;
  ] ;
  sh:property [
    sh:path skos:altLabel ;
    sh:name "Alternative names"@en, "Nomi alternativi"@it ;
    sh:datatype rdf:langString ;
    sh:description "Alternate names for the organization (e.g., acronyms, translations)" ;
  ] ;
  sh:property [
    sh:path owl:sameAs ;
    sh:name "External identifiers"@en, "Identificativi esterni"@it ;
    sh:minCount 0 ;
    sh:nodeKind sh:IRI ;
    sh:description "External identifier for the organization (use to link to Wikidata)" ;
  ] ;
  sh:property [
    sh:path wdt:P214 ;
    sh:name "VIAF ID"@en, "Identificativo VIAF"@it ;
    sh:minCount 0 ;
    sh:maxCount 1 ;
    sh:datatype xsd:string ;
    sh:pattern "^[1-9]([0-9]{1,8}|[0-9]{18,21})$" ;
    sh:description "VIAF cluster ID (Wikidata P214), stored as Wikidata stores it: the bare ID text, e.g. \"100995617\". The VIAF IRI is http://viaf.org/viaf/ followed by the ID, the formatter URI for RDF resource (P1921) Wikidata declares for P214." ;
  ] ;
  sh:property [
    sh:path wdt:P5504 ;
    sh:name "RISM ID"@en, "Identificativo RISM"@it ;
    sh:minCount 0 ;
    sh:maxCount 1 ;
    sh:datatype xsd:string ;
    sh:pattern "^institutions/[0-9]+$" ;
    sh:description "RISM ID (Wikidata P5504), stored as Wikidata stores it: the record type and number, e.g. \"institutions/30002520\". The RISM page is https://rism.online/ followed by the ID, the formatter URL (P1630) Wikidata declares for P5504." ;
  ] ;
  sh:property [
    sh:path core:hasPlace ;
    sh:name "Location"@en, "Sede"@it ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:class core:Place ;
    sh:node rfdbs:PlaceShape ;
    sh:description "Location of the organization" ;
  ] .


# ================================
# Shape for Language (Glottolog / dcterms:LinguisticSystem)
# ================================
# This shape targets dcterms:LinguisticSystem, the class used in glottolog_language.ttl.
rfdbs:LanguageShape
  a sh:NodeShape ;
  sh:targetClass dcterms:LinguisticSystem ;
  rdfs:label "Language"@en, "Lingua"@it ;
  sh:description "A language resource from a controlled vocabulary (e.g. Glottolog). Reference data: browse and select only."@en ;
  sh:property [
    sh:path rdfs:label ;
    sh:name "Name"@en, "Nome"@it ;
    sh:minCount 1 ;
    sh:datatype rdf:langString ;
    sh:description "Primary label for the language (e.g. 'Russian'@en)" ;
  ] ;
  sh:property [
    sh:path skos:prefLabel ;
    sh:name "Preferred name"@en, "Nome preferito"@it ;
    sh:datatype rdf:langString ;
    sh:description "Preferred label (skos:prefLabel), present in Glottolog data" ;
  ] .



# ================================
# Shape for Donor of Source
# here called Contributor
# Deliberately uses foaf:Person / foaf:Organization, NOT core:Person /
# core:Organization. This keeps Contributor identities structurally
# separate from composers, librettists, and holding institutions:
# donor/provenance attribution is intentionally modeled with
# dcterms:contributor, not with the open core:Role vocabulary used by
# core:hasAgentRole bridge records for creative/performance participation.
# a node can only satisfy this shape if it is explicitly typed
# foaf:Person or foaf:Organization, which none of the core:-typed
# entities elsewhere in this file are. Reusing a core:Person node here
# would require deliberately adding that type, not an accidental slip.
# ================================
rfdbs:ContributorShape
a sh:NodeShape ;
rdfs:label "Contributor"@en, "Collaboratore"@it ;
sh:targetClass foaf:Agent ;
sh:description "A person or institution credited as a contributor to a source, e.g. the donor of a digital copy — kept structurally separate from core:Person/core:Organization." ;
sh:or (
  [ sh:class foaf:Person ]
  [ sh:class foaf:Organization ]
) ;
sh:property [
    sh:path rdfs:label ;
    sh:name "Short name"@en, "Nome breve"@it ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:or (
      [ sh:datatype rdf:langString ]
      [ sh:datatype xsd:string ]
    ) ;
    sh:description "Contributor's short name (person or organization)" ;
  ] ;
sh:property [
  sh:path foaf:name ;
  sh:name "Full name"@en, "Nome completo"@it ;
  sh:minCount 1 ;
  sh:maxCount 1 ;
  sh:or ( [ sh:datatype rdf:langString ] [ sh:datatype xsd:string ] ) ;
  sh:description "Contributor's full name (person first last name or organization official expanded name)" ;
] .


# ================================
# Shape for Performance (LRMoo F31)
# Uses two distinct manifestation links on purpose:
# - cidoc:P19_was_intended_use_of for stronger "created for this staging" claims
# - cidoc:P16_used_specific_object for weaker "used/present at this staging" claims
# Keep both relations distinct; they represent different evidentiary strength.
# ================================
rfdbs:PerformanceShape
  a sh:NodeShape ;
  sh:targetClass lrmoo:F31_Performance ;
  rdfs:label "Performance"@en, "Rappresentazione"@it ;
  sh:description "A specific performance event (or run of performances) that performed a musical Work, e.g., an opera staged on a given date at a given theatre."@en ;

  sh:property [
    sh:path rdfs:label ;
    sh:name "Title"@en, "Titolo"@it ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:or (
      [ sh:datatype rdf:langString ]
      [ sh:datatype xsd:string ]
    ) ;
    sh:description "A performance must have exactly one label" ;
  ] ;

  sh:property [
    sh:path lrmoo:R80_performed ;
    sh:name "Work performed"@en, "Opera rappresentata"@it ;
    sh:minCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:class lrmoo:F1_Work ;
    sh:node rfdbs:MusicalWorkShape ;
    sh:description "The Work performed (R80 performed / is performed in)" ;
  ] ;

  sh:property [
    sh:path dcterms:date ;
    sh:name "Date"@en, "Data"@it ;
    sh:maxCount 1 ;
    sh:or (
      [ sh:datatype xsd:date ]
      [ sh:datatype xsd:gYear ]
      [ sh:datatype xsd:gYearMonth ]
    ) ;
    sh:description "Date of the performance, e.g., '1734'^^xsd:gYear" ;
  ] ;

  sh:property [
    sh:path core:hasPlace ;
    sh:name "Place"@en, "Luogo"@it ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:class core:Place ;
    sh:node rfdbs:PlaceShape ;
    sh:description "Venue of the performance, e.g., rfdb:RegioDucalTeatroMilano" ;
  ] ;

  sh:property [
    sh:path core:hasAgentRole ;
    sh:name "Persons and roles"@en, "Persone e ruoli"@it ;
    sh:nodeKind sh:IRI ;
    sh:class core:AgentRole ;
    sh:node rfdbs:AgentRoleShape ;
    sh:description "Agent roles for the performance: conductor, director, cast, etc." ;
  ] ;

  sh:property [
    sh:path cidoc:P19_was_intended_use_of ;
    sh:name "Manifestation made for this performance"@en, "Manifestazione realizzata per questa rappresentazione"@it ;
    sh:nodeKind sh:IRI ;
    sh:class lrmoo:F3_Manifestation ;
    sh:node rfdbs:ManifestationShape ;
    sh:description "STRONG claim: manifestation was created specifically for this performance (P19 was intended use of / was made for). Use when the printing itself was occasioned by this staging, e.g. a libretto edition whose title page names this specific production. Do not use when the manifestation predates or outlives this one occasion." ;
  ] ;

  sh:property [
    sh:path cidoc:P16_used_specific_object ;
    sh:name "Manifestation used at this performance"@en, "Manifestazione usata in questa rappresentazione"@it ;
    sh:nodeKind sh:IRI ;
    sh:class lrmoo:F3_Manifestation ;
    sh:node rfdbs:ManifestationShape ;
    sh:description "WEAK claim: manifestation was present/used at this performance (P16 used specific object / was used for), with no assertion about why it was printed. Use for a pre-existing or reused edition adopted for this staging, or whenever purpose-of-printing is unknown or unconfirmed. Safer default when evidence for intent is lacking." ;
  ] ;

  sh:property [
    sh:path owl:sameAs ;
    sh:name "External identifiers"@en, "Identificativi esterni"@it ;
    sh:minCount 0 ;
    sh:nodeKind sh:IRI ;
    sh:description "External identifier(s) for the performance/event, e.g. Corago ID such as https://corago.unibo.it/evento/0000376534" ;
  ] .
